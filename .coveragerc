# Configuracion de coverage.py para Alfred Dev.
#
# Mide cobertura de los modulos Python del plugin, excluyendo tests,
# la landing page (site/) y ficheros de configuracion.

[run]
source = core, hooks, gui, mcp
omit =
    tests/*
    site/*
    */node_modules/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    raise NotImplementedError
show_missing = true
precision = 1

[html]
directory = coverage-html
