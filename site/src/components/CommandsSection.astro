---
/**
 * Seccion de comandos de Alfred Dev.
 *
 * Renderiza los 26 comandos agrupados en 5 categorías (Flujos, Contexto,
 * Continuidad, PM operativo, Herramientas) usando un layout de tabla
 * compacta. Cada categoría tiene una cabecera con etiqueta de color
 * y las filas de comandos ocupan un mínimo vertical.
 *
 * @example
 * ```astro
 * <CommandsSection
 *   header={data.commands.header}
 *   groups={data.commands.groups}
 *   optionalNote={data.commands.optionalNote}
 * />
 * ```
 */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import type { SectionHeader as SectionHeaderType, CommandGroup } from '@/types';

interface Props {
  header: SectionHeaderType;
  groups: CommandGroup[];
  optionalNote: string;
}

const { header, groups, optionalNote } = Astro.props;
---

<section id="commands">
  <div class="container">
    <SectionHeader
      label={header.label}
      labelColor={header.labelColor}
      title={header.title}
      description={header.description}
    />

    <div class="commands-groups fade-in">
      {groups.map((group) => (
        <div class="command-group">
          <div class="group-label" style={`color: ${group.color}; border-color: ${group.color}33;`}>
            {group.label}
          </div>
          <div class="group-table">
            {group.commands.map((cmd) => (
              <div class="command-row">
                <code class="command-name" style={`color: ${group.color};`}>{cmd.command}</code>
                <span class="command-desc" set:html={cmd.description} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="optional-note fade-in" set:html={optionalNote} />
  </div>
</section>

<style>
  /* ── Contenedor de grupos ───────────────────────────── */
  .commands-groups {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ── Grupo de categoría ─────────────────────────────── */
  .command-group {
    display: grid;
    grid-template-columns: 120px 1fr;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Etiqueta lateral de categoría */
  .group-label {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--bg-card);
    border-right: 1px solid;
    padding: 16px 0;
  }

  /* Tabla de comandos del grupo */
  .group-table {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
  }

  /* Fila individual de comando */
  .command-row {
    display: grid;
    grid-template-columns: 230px 1fr;
    align-items: baseline;
    gap: 20px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }

  .command-row:last-child {
    border-bottom: none;
  }

  .command-row:hover {
    background: var(--bg-card-hover);
  }

  /* Nombre del comando */
  .command-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Descripción */
  .command-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .command-desc :global(code) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--blue);
  }

  /* ── Nota de agentes opcionales ─────────────────────── */
  .optional-note {
    margin-top: 16px;
    padding: 14px 20px;
    background: var(--bg-card);
    border: 1px solid rgba(201, 169, 110, 0.2);
    border-radius: 8px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .optional-note :global(strong) {
    color: var(--text-bright);
  }

  /* ── Responsive 900px ───────────────────────────────── */
  @media (max-width: 900px) {
    .command-group {
      grid-template-columns: 1fr;
    }

    .group-label {
      writing-mode: horizontal-tb;
      transform: none;
      border-right: none;
      border-bottom: 1px solid;
      padding: 10px 16px;
      justify-content: flex-start;
    }
  }

  /* ── Responsive 600px ───────────────────────────────── */
  @media (max-width: 600px) {
    .command-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
