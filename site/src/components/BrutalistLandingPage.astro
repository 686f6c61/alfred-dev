const interpolateFaq = (value: string) =>
  value
    .replaceAll('{{LANDING_VERSION}}', landingVersion)
    .replaceAll('{{GITHUB_MAIN_VERSION}}', githubMainPlugin.version || (isEn ? 'unknown' : 'desconocida'))
    .replaceAll(
      '{{GITHUB_MAIN_COMMANDS}}',
      githubMainPlugin.commandCount > 0 ? String(githubMainPlugin.commandCount) : (isEn ? 'unknown' : 'desconocido'),
    );
const faqItems = data.faq.items.map((item) => ({
  ...item,
  question: ensureQuestionPunctuation(item.question),
  answerHtml: interpolateFaq(item.answerHtml),
}));



const latestChangelog = data.changelog[0];
const changelogPreview = [
  {
    label: uiText.added,
    items: (latestChangelog?.added ?? []).slice(0, 3).map(stripMd),
  },
  {
    label: uiText.changed,
    items: (latestChangelog?.changed ?? []).slice(0, 3).map(stripMd),
  },
  {
    label: uiText.fixed,
    items: (latestChangelog?.fixed ?? []).slice(0, 3).map(stripMd),
  },
].filter((section) => section.items.length > 0);

const softwareApplicationLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.meta.og.siteName,
  description: data.meta.description,
  url: data.meta.canonical,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  inLanguage: isEn ? 'en-US' : 'es-ES',
  softwareVersion: data.footer.version.replace(/^v/i, ''),
  datePublished: '2026-03-21',
  dateModified: latestChangelog?.date ?? '2026-03-31',
  image: data.meta.og.image,
  screenshot: data.meta.og.image,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  author: {
    '@type': 'Person',
    name: '686f6c61',
    url: data.footer.githubUrl,
    sameAs: [data.footer.githubUrl, 'https://x.com/686f6c61'],
  },
  publisher: {
    '@type': 'Organization',
    name: data.meta.og.siteName,
    url: data.footer.githubUrl,
