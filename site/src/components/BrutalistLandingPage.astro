          <div class="changelog-card__sections">
            {changelogPreview.map((section, index) => (
              <article class={`changelog-card__section tone-${index === 0 ? 'butter' : index === 1 ? 'pink' : 'sky'}`}>
                <strong>{section.label}</strong>
                <ul>
                  {section.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
