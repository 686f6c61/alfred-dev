});

const faqPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answerHtml.replace(/<[^>]*>/g, ''),
    },
  })),
});

const websiteLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: data.meta.og.siteName,
  url: data.meta.canonical,
  inLanguage: isEn ? 'en-US' : 'es-ES',
});

const organizationLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: data.meta.og.siteName,
  url: data.footer.githubUrl,
  logo: 'https://alfred-dev.com/favicon.png',
