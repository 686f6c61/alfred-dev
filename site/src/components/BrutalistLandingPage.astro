const featuredSkillIds = ['incident-response', 'sonarqube', 'release-planning', 'dependency-strategy', 'style-direction'];
const collectSkillFiles = (root: string, bucket: string[] = []) => {
  for (const entry of readdirSync(root, { withFileTypes: true })) {
    const entryPath = resolvePath(root, entry.name);
    if (entry.isDirectory()) {
      collectSkillFiles(entryPath, bucket);
    } else if (entry.isFile() && entry.name === 'SKILL.md') {
      bucket.push(entryPath);
    }
  }
  return bucket;
};
const skillCatalog = collectSkillFiles(resolvePath(repoRootPath, 'skills')).map((skillPath) => {
  const source = readFileSync(skillPath, 'utf8');
  const relativePath = skillPath.slice(repoRootPath.length).replace(/^[/\\]/, '');
  const [, domainId, skillId] = relativePath.match(/^skills\/([^/]+)\/([^/]+)\/SKILL\.md$/) ?? [];
  const description =
    parseFrontmatterField(source, 'description') ||
    (skillId === 'style-direction'
      ? 'Fija el sistema de diseño con 10 bases y 3 finalistas antes de tocar frontend.'
      : `Skill interno de ${skillDomainMeta[domainId]?.label ?? titleFromId(domainId)}.`);

  return {
    id: skillId,
    label: titleFromId(skillId),
    domainId,
    domainLabel: skillDomainMeta[domainId]?.label ?? titleFromId(domainId),
    description: upperFirst(description),
    featured: featuredSkillIds.includes(skillId),
  };
});
const skillDomains = skillDomainOrder
