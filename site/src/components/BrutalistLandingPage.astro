          <strong id="command-modal-title">/alfred-dev:command</strong>
          <span id="command-modal-chip" class="mini-tag mini-tag--sky">{tr('Operativo', 'Operational')}</span>
        </div>
        <button type="submit" class="modal__close">{uiText.close}</button>
      </div>

      <div class="command-modal">
        <aside class="command-modal__summary">
          <span id="command-modal-group" class="agent-modal__eyebrow">{tr('Grupo', 'Group')}</span>
          <h3 id="command-modal-summary">{tr('Resumen', 'Summary')}</h3>
          <p id="command-modal-detail" class="command-modal__detail"></p>

          <div class="command-modal__stats">
            <div class="tech-pill">
              <strong id="command-modal-core-count">0</strong>
              <span>{uiText.commandCoreLabel}</span>
            </div>
            <div class="tech-pill">
              <strong id="command-modal-optional-count">0</strong>
              <span>{uiText.commandOptionalLabel}</span>
            </div>
            <div class="tech-pill">
              <strong id="command-modal-layer-count">0</strong>
              <span>{uiText.commandLayersLabel}</span>
            </div>
            <div class="tech-pill">
              <strong id="command-modal-mode">{tr('Operativo', 'Operational')}</strong>
              <span>{uiText.mode}</span>
            </div>
          </div>
        </aside>

        <div class="command-modal__body">
          <section class="agent-modal__section">
            <h4>{uiText.commandCoreEntry}</h4>
            <div id="command-modal-core" class="command-modal__buttons"></div>
          </section>

          <section class="agent-modal__section">
            <h4>{uiText.commandOptionalEntry}</h4>
            <div id="command-modal-optional" class="command-modal__buttons"></div>
          </section>

          <section class="agent-modal__section">
            <h4>{uiText.commandLayerEntry}</h4>
            <div id="command-modal-layers" class="command-modal__buttons"></div>
          </section>

          <section class="agent-modal__section agent-modal__section--full">
            <h4>{uiText.commandReality}</h4>
            <ul id="command-modal-notes"></ul>
          </section>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="agent-modal" class="modal modal--large">
    <form method="dialog" class="modal__surface">
      <div class="modal__bar">
        <div class="agent-modal__title-wrap">
          <strong id="agent-modal-title">{uiText.agentLabel}</strong>
          <span id="agent-modal-chip" class="mini-tag mini-tag--peach">{uiText.core}</span>
        </div>
        <button type="submit" class="modal__close">{uiText.close}</button>
      </div>

      <div class="agent-modal">
        <aside class="agent-modal__summary">
          <span id="agent-modal-role" class="agent-modal__eyebrow">{uiText.agentRoleLabel}</span>
          <h3 id="agent-modal-summary">{tr('Resumen', 'Summary')}</h3>
          <p id="agent-modal-voice"></p>

          <dl class="agent-modal__specs">
            <div>
              <dt>{uiText.type}</dt>
              <dd id="agent-modal-type"></dd>
            </div>
            <div>
              <dt>{uiText.model}</dt>
              <dd id="agent-modal-model"></dd>
            </div>
            <div>
              <dt>{uiText.tools}</dt>
              <dd id="agent-modal-tools"></dd>
            </div>
          </dl>
        </aside>

        <div class="agent-modal__body">
          <section class="agent-modal__section agent-modal__section--full">
            <h4>{uiText.howItEnters}</h4>
            <ul id="agent-modal-flow"></ul>
          </section>

          <section class="agent-modal__section">
            <h4>{uiText.whatItDoesTitle}</h4>
            <ul id="agent-modal-does"></ul>
          </section>

          <section class="agent-modal__section">
            <h4>{uiText.whatItDoesntTitle}</h4>
            <ul id="agent-modal-doesnt"></ul>
          </section>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="layer-modal" class="modal">
    <form method="dialog" class="modal__surface">
      <div class="modal__bar">
        <div class="agent-modal__title-wrap">
          <strong id="layer-modal-title">{uiText.layerTitle}</strong>
          <span class="mini-tag mini-tag--sky">{uiText.runtimeLayer}</span>
        </div>
        <button type="submit" class="modal__close">{uiText.close}</button>
      </div>

      <div class="layer-modal">
        <p id="layer-modal-detail" class="layer-modal__lead"></p>

        <section class="agent-modal__section">
          <h4>{uiText.layerAdds}</h4>
          <ul id="layer-modal-points"></ul>
        </section>
      </div>
    </form>
  </dialog>

  <script is:inline>
    const installDialog = document.getElementById('install-modal');
    const uninstallDialog = document.getElementById('uninstall-modal');
    const installTitle = document.getElementById('install-modal-title');
    const installCommand = document.getElementById('install-modal-command');
    const installCopyButton = document.getElementById('install-copy-button');
    const changelogDialog = document.getElementById('changelog-modal');
    const originDialog = document.getElementById('origin-modal');
    const techDialog = document.getElementById('tech-modal');
    const commandDialog = document.getElementById('command-modal');
    const agentDialog = document.getElementById('agent-modal');
    const layerDialog = document.getElementById('layer-modal');
    const uiCopyNode = document.getElementById('landing-ui-copy');
    const agentCatalogNode = document.getElementById('agent-catalog');
    const commandCatalogNode = document.getElementById('command-catalog');
    const layerCatalogNode = document.getElementById('layer-catalog');
    const collaborationEggNode = document.getElementById('collaboration-egg');
    const uiCopy = uiCopyNode ? JSON.parse(uiCopyNode.textContent || '{}') : {};
    const agentCatalog = agentCatalogNode ? JSON.parse(agentCatalogNode.textContent || '[]') : [];
    const commandCatalog = commandCatalogNode ? JSON.parse(commandCatalogNode.textContent || '[]') : [];
    const layerCatalog = layerCatalogNode ? JSON.parse(layerCatalogNode.textContent || '[]') : [];
    const collaborationEgg = collaborationEggNode ? JSON.parse(collaborationEggNode.textContent || '{}') : null;
    const commandTitle = document.getElementById('command-modal-title');
    const commandChip = document.getElementById('command-modal-chip');
    const commandGroup = document.getElementById('command-modal-group');
    const commandSummary = document.getElementById('command-modal-summary');
    const commandDetail = document.getElementById('command-modal-detail');
    const commandCoreCount = document.getElementById('command-modal-core-count');
    const commandOptionalCount = document.getElementById('command-modal-optional-count');
    const commandLayerCount = document.getElementById('command-modal-layer-count');
    const commandMode = document.getElementById('command-modal-mode');
    const commandCore = document.getElementById('command-modal-core');
    const commandOptional = document.getElementById('command-modal-optional');
    const commandLayers = document.getElementById('command-modal-layers');
    const commandNotes = document.getElementById('command-modal-notes');
    const agentTitle = document.getElementById('agent-modal-title');
    const agentChip = document.getElementById('agent-modal-chip');
    const agentRole = document.getElementById('agent-modal-role');
    const agentSummary = document.getElementById('agent-modal-summary');
    const agentVoice = document.getElementById('agent-modal-voice');
    const agentType = document.getElementById('agent-modal-type');
    const agentModel = document.getElementById('agent-modal-model');
    const agentTools = document.getElementById('agent-modal-tools');
    const agentDoes = document.getElementById('agent-modal-does');
    const agentDoesnt = document.getElementById('agent-modal-doesnt');
    const agentFlow = document.getElementById('agent-modal-flow');
    const layerTitle = document.getElementById('layer-modal-title');
    const layerDetail = document.getElementById('layer-modal-detail');
    const layerPoints = document.getElementById('layer-modal-points');
    const commandTagClass = {
      peach: 'mini-tag mini-tag--peach',
      pink: 'mini-tag mini-tag--pink',
      sky: 'mini-tag mini-tag--sky',
      butter: 'mini-tag mini-tag--butter',
      lavender: 'mini-tag mini-tag--lavender',
    };

    const copyText = async (text, button) => {
      try {
        await navigator.clipboard.writeText(text);
        const original = button.textContent;
        button.textContent = uiCopy.copied || 'Copied';
        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      } catch {
        button.textContent = uiCopy.manualCopy || 'Copy manually';
      }
    };

    document.querySelectorAll('[data-install-trigger]').forEach((button) => {
      button.addEventListener('click', async () => {
        const platform = button.dataset.platform || uiCopy.installModalTitle || 'Installation';
        const command = button.dataset.command || '';

        installTitle.textContent = `${uiCopy.installationOn || 'Install on'} ${platform}`;
        installCommand.textContent = command;
        installCopyButton.dataset.command = command;

        if (!installDialog.open) {
          installDialog.showModal();
        }

        if (command) {
          await copyText(command, installCopyButton);
        }
      });
    });

    installCopyButton?.addEventListener('click', async () => {
      const command = installCopyButton.dataset.command || '';
      if (command) {
        await copyText(command, installCopyButton);
      }
    });

    document.querySelectorAll('[data-copy-command]').forEach((button) => {
      button.addEventListener('click', async () => {
        const command = button.dataset.copyValue || '';
        if (command) {
          await copyText(command, button);
        }
      });
    });

    document.querySelectorAll('[data-changelog-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        if (techDialog?.open) {
          techDialog.close();
        }
        if (!changelogDialog.open) {
          changelogDialog.showModal();
        }
      });
    });

    document.querySelectorAll('[data-origin-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!originDialog?.open) {
          originDialog.showModal();
        }
      });
    });

    document.querySelectorAll('[data-tech-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!techDialog.open) {
          techDialog.showModal();
        }
      });
    });

    document.querySelectorAll('[data-uninstall-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!uninstallDialog?.open) {
          uninstallDialog.showModal();
        }
      });
    });

    const renderAgentList = (target, items, emptyLabel) => {
      if (!target) return;
      target.innerHTML = '';
      const values = Array.isArray(items) && items.length > 0 ? items : [emptyLabel];

      values.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        target.appendChild(li);
      });
    };

    const renderEntityButtons = (target, items, triggerKind, emptyLabel) => {
      if (!target) return;
      target.innerHTML = '';

      if (!Array.isArray(items) || items.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'command-modal__empty';
        empty.textContent = emptyLabel;
        target.appendChild(empty);
        return;
      }

      items.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `command-modal__pill command-modal__pill--${triggerKind}`;
        button.textContent = item.label || item.title || item.id;

        if (triggerKind === 'agent') {
          button.dataset.agentTrigger = '';
          button.dataset.agentId = item.id;
        } else if (triggerKind === 'layer') {
          button.dataset.layerTrigger = '';
          button.dataset.layerId = item.id;
        }

        target.appendChild(button);
      });
    };

    const openAgent = (agentId) => {
      const agent = agentCatalog.find((entry) => entry.id === agentId);
      if (!agent || !agentDialog) return;

      if (commandDialog?.open) {
        commandDialog.close();
      }

      if (agentTitle) agentTitle.textContent = agent.label;
      if (agentChip) {
        agentChip.textContent = agent.group === 'core' ? (uiCopy.coreTag || 'Core') : (uiCopy.optionalTag || 'Optional');
        agentChip.className = `mini-tag ${agent.group === 'core' ? 'mini-tag--peach' : 'mini-tag--sky'}`;
      }
      if (agentRole) agentRole.textContent = agent.role;
      if (agentSummary) agentSummary.textContent = agent.cardSummary;
      if (agentVoice) agentVoice.textContent = agent.voice;
      if (agentType) agentType.textContent = agent.type;
      if (agentModel) agentModel.textContent = agent.model;
      if (agentTools) agentTools.textContent = agent.tools;

      renderAgentList(agentDoes, agent.does, uiCopy.locale === 'en' ? 'Coordinates work and contributes judgment inside its domain.' : 'Coordina y aporta criterio sobre su ámbito.');
      renderAgentList(agentDoesnt, agent.doesnt, uiCopy.locale === 'en' ? 'It does not replace the rest of the flow or invent work outside scope.' : 'No sustituye al resto del flujo ni inventa trabajo fuera de alcance.');
      renderAgentList(agentFlow, agent.flowItems, uiCopy.locale === 'en' ? 'It enters when Alfred or the user need its specific judgment.' : 'Entra cuando Alfred o el usuario necesitan su criterio específico.');

      if (!agentDialog.open) {
        agentDialog.showModal();
      }
    };

    const openLayer = (layerId) => {
      const layer = layerCatalog.find((entry) => entry.id === layerId);
      if (!layer || !layerDialog) return;

      if (commandDialog?.open) {
        commandDialog.close();
      }

      if (layerTitle) layerTitle.textContent = layer.title;
      if (layerDetail) layerDetail.textContent = layer.detail;
      renderAgentList(layerPoints, layer.points, uiCopy.locale === 'en' ? 'Adds an operational capability complementary to the main flow.' : 'Aporta una capacidad operativa complementaria al flujo principal.');

      if (!layerDialog.open) {
        layerDialog.showModal();
      }
    };

    const openCommand = (commandId) => {
      const command = commandCatalog.find((entry) => entry.id === commandId);
      if (!command || !commandDialog) return;

      const core = (command.coreAgents || [])
        .map((id) => agentCatalog.find((entry) => entry.id === id))
        .filter(Boolean);
      const optional = (command.optionalAgents || [])
        .map((id) => agentCatalog.find((entry) => entry.id === id))
        .filter(Boolean);
      const layers = (command.layerIds || [])
        .map((id) => layerCatalog.find((entry) => entry.id === id))
        .filter(Boolean);

      if (commandTitle) commandTitle.textContent = command.label;
      if (commandChip) {
        commandChip.textContent = command.mode;
        commandChip.className = commandTagClass[command.tone] || 'mini-tag mini-tag--black';
      }
      if (commandGroup) commandGroup.textContent = `${command.group} / ${command.subtitle}`;
      if (commandSummary) commandSummary.textContent = command.description;
      if (commandDetail) commandDetail.textContent = command.detail;
      if (commandCoreCount) commandCoreCount.textContent = String(core.length);
      if (commandOptionalCount) commandOptionalCount.textContent = String(optional.length);
      if (commandLayerCount) commandLayerCount.textContent = String(layers.length);
      if (commandMode) commandMode.textContent = command.mode;

      renderEntityButtons(commandCore, core, 'agent', uiCopy.locale === 'en' ? 'No additional core team enters here.' : 'Aquí no entra un equipo de núcleo adicional.');
      renderEntityButtons(commandOptional, optional, 'agent', uiCopy.locale === 'en' ? 'No optional specialists enter here by default.' : 'Aquí no entran opcionales por defecto.');
      renderEntityButtons(commandLayers, layers, 'layer', uiCopy.locale === 'en' ? 'This command does not activate specific auxiliary layers.' : 'Este comando no activa capas auxiliares específicas.');
      renderAgentList(commandNotes, command.notes, uiCopy.locale === 'en' ? 'Follow the protocol documented for the command itself.' : 'Sigue el protocolo documentado del propio comando.');

      if (!commandDialog.open) {
        commandDialog.showModal();
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const commandTrigger = target.closest('[data-command-trigger]');
      if (commandTrigger instanceof HTMLElement) {
        event.preventDefault();
        openCommand(commandTrigger.dataset.commandId);
        return;
      }

      const agentTrigger = target.closest('[data-agent-trigger]');
      if (agentTrigger instanceof HTMLElement) {
        event.preventDefault();
        openAgent(agentTrigger.dataset.agentId);
        return;
      }

      const layerTrigger = target.closest('[data-layer-trigger]');
      if (layerTrigger instanceof HTMLElement) {
        event.preventDefault();
        openLayer(layerTrigger.dataset.layerId);
      }
    });

    // Easter egg para quien abra DevTools y quiera empujar el proyecto.
    if (collaborationEgg?.url) {
      console.groupCollapsed(
        `%c${collaborationEgg.label || 'ALFRED DEV / COLLABORATION'}`,
        'background:#111111;color:#f7f0e8;padding:6px 10px;font-weight:800;font-family:\"JetBrains Mono\", monospace;',
      );
      if (collaborationEgg.lead) {
        console.info(collaborationEgg.lead);
      }
      if (collaborationEgg.body) {
        console.info(collaborationEgg.body);
      }
      console.info(`${collaborationEgg.cta || 'Open issues at:'} ${collaborationEgg.url}`);
      console.groupEnd();
    }
  </script>

