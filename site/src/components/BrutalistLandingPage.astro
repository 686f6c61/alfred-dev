  const nested = relativePath.match(/^skills\/([^/]+)\/([^/]+)\/SKILL\.md$/);
  const flat = relativePath.match(/^skills\/([^/]+)\/SKILL\.md$/);
  const skillId = nested?.[2] ?? flat?.[1] ?? '';
  const domainId = skillToDomain[skillId] ?? nested?.[1] ?? 'proceso';
  const description =
    parseFrontmatterField(source, 'description') ||
    (skillId === 'style-direction'
      ? 'Fija el sistema de diseño antes de tocar frontend.'
