---

<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  canonical={canonicalUrl}
  locale={isEn ? 'en-US' : 'es-ES'}
  ogLocale={data.meta.locale}
  alternates={[
    { hreflang: isEn ? 'en' : 'es', href: canonicalUrl },
    { hreflang: isEn ? 'es' : 'en', href: alternateUrl },
    { hreflang: 'x-default', href: isEn ? alternateUrl : canonicalUrl },
  ]}
  ogTitle={data.meta.og.title}
  ogDescription={data.meta.og.description}
  ogImage={data.meta.og.image}
  ogImageWidth={data.meta.og.imageWidth}
  ogImageHeight={data.meta.og.imageHeight}
  ogImageType={data.meta.og.imageType}
  ogImageAlt={data.meta.og.imageAlt}
  twitterCard={data.meta.twitter.card}
  twitterTitle={data.meta.twitter.title}
  twitterDescription={data.meta.twitter.description}
  twitterImage={data.meta.twitter.image}
  twitterImageAlt={data.meta.twitter.imageAlt}
  twitterSite={data.meta.twitter.site}
  twitterCreator={data.meta.twitter.creator}
>
  <script slot="head" is:inline type="application/ld+json" set:html={softwareApplicationLd} />
  <script slot="head" is:inline type="application/ld+json" set:html={faqPageLd} />
  <script slot="head" is:inline type="application/ld+json" set:html={websiteLd} />
  <script slot="head" is:inline type="application/ld+json" set:html={organizationLd} />
  <script slot="head" is:inline id="agent-catalog" type="application/json" set:html={JSON.stringify(agentCatalogClient)} />
  <script slot="head" is:inline id="command-catalog" type="application/json" set:html={JSON.stringify(commandCatalogClient)} />
  <script slot="head" is:inline id="layer-catalog" type="application/json" set:html={JSON.stringify(auxiliaryLayersClient)} />
  <script slot="head" is:inline id="landing-ui-copy" type="application/json" set:html={JSON.stringify(uiText)} />
  <script slot="head" is:inline id="collaboration-egg" type="application/json" set:html={JSON.stringify(collaborationEgg)} />

  <main id="contenido" class="beta-page">
    <header class="topbar panel panel-cream">
      <div class="topbar__brand">
        <button type="button" class="topbar__brand-trigger" data-origin-trigger aria-label={uiText.originAriaLabel}>
          <span class="topbar__brand-mark" aria-hidden="true">
            <img src={brandIconHref} alt="" width="28" height="28" loading="eager" decoding="async" />
          </span>
          <span class="mini-tag mini-tag--black">ALFRED DEV</span>
        </button>
        <span class="mini-tag mini-tag--peach">{data.footer.version}</span>
        <span class="topbar__note">{uiText.topbarNote}</span>
      </div>
      <div class="topbar__actions">
        <button class="topbar__link topbar__link--icon" type="button" data-tech-trigger>
          <span class="topbar__icon" set:html={icons.reality}></span>
          {uiText.technicalVision}
        </button>
        <a class="topbar__link topbar__link--icon" href={data.footer.githubUrl} target="_blank" rel="noreferrer">
          <span class="topbar__icon" set:html={icons.github}></span>
          GitHub
        </a>
        <a class="topbar__link" href={uiText.languageHref} hreflang={uiText.locale === 'es' ? 'en' : 'es'}>
          {uiText.languageLabel}
        </a>
      </div>
    </header>

    <section class="hero-grid">
      <div class="panel panel-pink hero-copy">
        <div class="hero-copy__eyebrow">{tr('Claude Code, pero con equipo', 'Claude Code, but with a team')}</div>
        <div class="hero-copy__sticker">{tr('PLUGIN PARA CLAUDE CODE', 'PLUGIN FOR CLAUDE CODE')}</div>
        <h1>{tr('UN SISTEMA DE TRABAJO PARA CLAUDE CODE', 'A WORK SYSTEM FOR CLAUDE CODE')}</h1>
        <p class="hero-copy__body">
          {tr(
            '10 agentes, 18 comandos /alfred-dev:*, 11 skills planas, memoria SQLite y gates con evidencia. Alineado con el SDK de Claude Code.',
            '10 agents, 18 /alfred-dev:* commands, 11 flat skills, SQLite memory, and evidence-backed gates. Aligned with the Claude Code SDK.',
          )}
        </p>

        <div class="hero-stats">
          <span class="hero-chip hero-chip--butter">{tr('10 agentes', '10 agents')}</span>
          <span class="hero-chip hero-chip--mint">{tr('18 comandos', '18 commands')}</span>
          <span class="hero-chip hero-chip--sky">{tr('SQLite + MCP', 'SQLite + MCP')}</span>
        </div>

        <div class="hero-install">
          {Object.values(installCommands).map((item, index) => (
            <button
              type="button"
              class={`hero-install__button tone-${index === 0 ? 'butter' : index === 1 ? 'sky' : 'mint'}`}
              data-install-trigger
              data-platform={item.platform}
              data-command={item.command}
            >
              <span class="platform-action__icon" set:html={item.icon}></span>
              <span class="platform-action__label">{item.label}</span>
            </button>
          ))}
