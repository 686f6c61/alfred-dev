};
const activeTechnicalVision = isEn ? technicalVisionEn : technicalVision;
const activeAlfredOrigin = isEn ? alfredOriginEn : alfredOrigin;
const collaborationIssueUrl = `${data.footer.githubUrl}/issues`;
const collaborationEgg = {
  label: tr('ALFRED DEV / COLABORACIÓN', 'ALFRED DEV / COLLABORATION'),
  lead: tr(
    'Si te apetece colaborar en Alfred Dev, deja una issue en el repo.',
    'If you want to collaborate on Alfred Dev, open an issue in the repo.',
  ),
  body: tr(
    'Si compartimos enfoque y estilo de trabajo, te daré prioridad para colaborar y figurar como coautor.',
