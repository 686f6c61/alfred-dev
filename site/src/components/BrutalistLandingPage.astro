const alternateUrl = isEn ? 'https://alfred-dev.com/' : 'https://alfred-dev.com/en/';
const repoRootPath = resolvePath(process.cwd(), '..');
const tr = (es: string, en: string) => (isEn ? en : es);
const readGithubMainPlugin = () => {
  try {
    const raw = execFileSync('git', ['show', 'origin/main:.claude-plugin/plugin.json'], {
      cwd: repoRootPath,
      encoding: 'utf8',
    });
    const manifest = JSON.parse(raw) as { version?: string; commands?: unknown[] };
    return {
      version: String(manifest.version ?? ''),
      commandCount: Array.isArray(manifest.commands) ? manifest.commands.length : 0,
    };
  } catch {
    return { version: '', commandCount: 0 };
  }
};
const githubMainPlugin = readGithubMainPlugin();
const landingVersion = data.footer.version.replace(/^v/i, '');
const installOneLinerMatchesLanding =
  Boolean(githubMainPlugin.version) && githubMainPlugin.version === landingVersion;
const mainInstallCreatesAlfredAlias = githubMainPlugin.version.startsWith('0.6');

const stripMd = (value: string) =>
  value
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]*>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const formatDateEs = (value: string) => {
  const [year, month, day] = value.split('-');
  if (!year || !month || !day) return value;
  return `${day}/${month}/${year}`;
};
const formatDate = (value: string) => (isEn ? value : formatDateEs(value));
const ensureQuestionPunctuation = (value: string) => {
  const normalized = value.trim().replace(/^¿+/, '').replace(/\?+$/, '');
  return isEn ? `${normalized}?` : `¿${normalized}?`;
};
const readRepoFile = (path: string) => readFileSync(resolvePath(repoRootPath, path), 'utf8');
