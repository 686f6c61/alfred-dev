const agentCatalog = agentMeta.map((meta) => {
  const source = readRepoFile(`docs/agents/${meta.file}`);
  const heading = stripMd(source.match(/^#\s+(.+)$/m)?.[1] ?? meta.label);
  const [aliasPart, straplinePart = ''] = heading.split(/\s+--\s+/);
  const introSection = getSection(source, ['Qu[ií]en es']);
  const introParagraphs = getParagraphs(introSection, 2);
  const configRows = getTableData(getSection(source, ['Configuraci[oó]n t[eé]cnica']));
  const responsibilities = getSection(source, ['Responsabilidades']);
  const flows = getSection(source, ['Flujos']);
  const englishProfile = englishAgentProfileMap[meta.id as keyof typeof englishAgentProfileMap];
  const englishLists = buildEnglishAgentLists(meta, englishProfile?.role ?? meta.cardSummary);

  return {
    ...meta,
    alias: isEn ? upperFirst(englishProfile?.alias ?? meta.label) : upperFirst(aliasPart),
    strapline: isEn ? upperFirst(englishProfile?.phrase ?? '') : upperFirst(stripMd(straplinePart)),
    cardSummary: upperFirst(meta.cardSummary),
    summary: upperFirst(introParagraphs[0] ?? meta.cardSummary),
    description: introParagraphs.map(upperFirst).join('\n\n'),
    voice: upperFirst(agentVoiceMap[locale][meta.id] ?? introParagraphs[1] ?? introParagraphs[0] ?? meta.cardSummary),
    role: isEn ? upperFirst(englishProfile?.alias ?? meta.label) : getTableValue(configRows, ['Rol']) || meta.label,
    model: isEn
      ? upperFirst(englishProfile?.model ?? (getTableValue(configRows, ['Modelo']) || 'N/A'))
      : getTableValue(configRows, ['Modelo']) || 'N/D',
    tools: getTableValue(configRows, ['Herramientas']) || 'N/D',
    type: isEn ? (meta.group === 'core' ? 'Core' : 'Optional') : getTableValue(configRows, ['Tipo']) || (meta.group === 'core' ? 'Núcleo' : 'Opcional'),
    does: isEn ? englishLists.does : getBullets(responsibilities, ['Lo que hace', 'Qu[eé] hace']).slice(0, 4).map(upperFirst),
    doesnt: isEn ? englishLists.doesnt : getBullets(responsibilities, ['Lo que NO hace', 'Qu[eé] NO hace', 'Qu[eé] no hace']).slice(0, 4).map(upperFirst),
    flowItems: isEn ? englishLists.flowItems : getListItems(flows).slice(0, 4).map(upperFirst),
  };
});

