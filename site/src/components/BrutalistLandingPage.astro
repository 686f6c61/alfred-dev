                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="beta-section" id="skills">
      <div class="skills-grid">
        <article class="panel tone-sky skills-card">
          <div class="skills-card__head">
            <h2>
              <span class="title-icon" set:html={icons.skills}></span>
