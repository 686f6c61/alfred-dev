const collectSkillFiles = (root: string, bucket: string[] = []) => {
  for (const entry of readdirSync(root, { withFileTypes: true })) {
    const entryPath = resolvePath(root, entry.name);
    if (entry.isDirectory()) {
      collectSkillFiles(entryPath, bucket);
    } else if (entry.isFile() && entry.name === 'SKILL.md') {
      bucket.push(entryPath);
    }
  }
  return bucket;
};
