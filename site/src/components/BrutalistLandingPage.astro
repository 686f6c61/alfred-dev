const upperFirst = (value: string) => (value ? value.charAt(0).toUpperCase() + value.slice(1) : value);
const titleFromId = (value: string) =>
  value
    .split('-')
    .map((part) => titleWordMap[part.toLowerCase()] ?? upperFirst(part))
    .join(' ');
const getSection = (source: string, patterns: string[]) => {
  for (const pattern of patterns) {
    const match = new RegExp(`^##\\s+${pattern}\\s*$`, 'mi').exec(source);
    if (!match) continue;
    const start = match.index + match[0].length;
    const rest = source.slice(start);
    const next = rest.search(/^##\s+/m);
    return (next === -1 ? rest : rest.slice(0, next)).trim();
  }
  return '';
};
const getParagraphs = (section: string, max = 1) =>
  section
    .split(/\n\s*\n/)
    .map((part) => stripMd(part))
    .filter(Boolean)
    .slice(0, max);
const getTableData = (section: string) => {
  const rows: Record<string, string> = {};
  for (const line of section.split('\n')) {
    if (!line.trim().startsWith('|') || line.includes('---')) continue;
    const cells = line
      .split('|')
      .slice(1, -1)
      .map((cell) => stripMd(cell));
    if (cells.length >= 2) {
      rows[cells[0].toLowerCase()] = cells[1];
    }
  }
  return rows;
};
const getTableValue = (rows: Record<string, string>, keys: string[]) => {
  for (const key of keys) {
    const found = Object.entries(rows).find(([rowKey]) => rowKey.includes(key.toLowerCase()));
    if (found) return found[1];
  }
  return '';
};
const getListItems = (section: string) =>
  section
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => /^(- |\d+\.\s)/.test(line))
    .map((line) => stripMd(line.replace(/^(- |\d+\.\s)/, '')))
    .filter(Boolean);
const getBullets = (section: string, markers: string[]) => {
  const lines = section.split('\n');
  const markerIndex = lines.findIndex((line) =>
    markers.some((marker) => new RegExp(marker, 'i').test(stripMd(line))),
  );
  if (markerIndex === -1) return [];
  const items: string[] = [];
  for (let index = markerIndex + 1; index < lines.length; index += 1) {
    const line = lines[index].trim();
    if (!line) continue;
    if (/^(?:\*\*|###|##)/.test(line) && items.length > 0) break;
    if (/^- /.test(line)) {
      items.push(stripMd(line.replace(/^- /, '')));
      continue;
    }
    if (items.length > 0) break;
  }
  return items;
};
const parseFrontmatterField = (source: string, field: string) => {
  const match = source.match(new RegExp(`^${field}:\\s*(.+)$`, 'm'));
  return match ? stripMd(match[1].replace(/^"(.*)"$/, '$1')) : '';
};
