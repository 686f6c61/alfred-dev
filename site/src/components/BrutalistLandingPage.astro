          </div>

          <div class="skills-card__body">
            <div class="skills-card__meter">
              <strong>{skillCatalog.length}</strong>
              <span>{uiText.publishedSkillsLabel}</span>
              <small>{uiText.domainsCovered}</small>
            </div>

            <div class="skills-card__copy">
              <p>{uiText.skillsBody}</p>
              <h3>{uiText.publicSkills}</h3>
              <div class="skills-card__chips">
                {featuredSkills.map((skill) => (
                  <span class="command-chip command-chip--dark">{skill.label}</span>
                ))}
              </div>
              <div class="skills-card__footer">
                {uiText.skillsFooter}
              </div>
            </div>
          </div>

          <div class="skills-card__domains">
            {skillDomains.slice(0, 6).map((domain) => (
              <div class="skills-domain">
                <div class="skills-domain__head">
                  <strong>{domain.label}</strong>
                  <span>{domain.count} {domain.count === 1 ? 'skill' : 'skills'}</span>
                </div>
                <small>{domain.skills.map((skill) => skill.label).join(' · ')}</small>
              </div>
            ))}
          </div>
        </article>

        <article class="panel tone-pink aux-card">
          <div class="skills-card__head">
            <h2>
              <span class="title-icon" set:html={icons.layers}></span>
              {uiText.auxiliaryLayers}
            </h2>
            <span class="mini-tag mini-tag--black">{uiText.auxiliaryLayersBadge}</span>
          </div>

          <div class="aux-grid">
            {auxiliaryLayers.map((item) => (
              <article class="aux-tile">
                <button type="button" class="aux-tile__button" data-layer-trigger data-layer-id={item.id}>
                  <strong>{item.title}</strong>
                  <span>{item.body}</span>
                  <small>{uiText.auxiliaryOpen}</small>
                </button>
              </article>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="beta-section" id="instalar">
      <div class="section-heading">
        <h2 class="headline headline--small">
          <span class="section-icon section-icon--inline" set:html={icons.install}></span>
          {uiText.installSection} <span class="mini-tag mini-tag--black">{uiText.installStepsBadge}</span>
        </h2>
      </div>

      <div class="start-grid">
        <article class="panel tone-sky start-card">
          <div class="start-card__head">
            <h3>{uiText.startInThreeSteps}</h3>
            <span class="mini-tag mini-tag--black">entry flow</span>
          </div>

          <div class="start-step">
            <strong>01</strong>
            <div>
              <h4>{tr('Instala Alfred Dev', 'Install Alfred Dev')}</h4>
              <p>{tr('El script pide Claude CLI y Python 3.10+. Instala con --scope user. Luego /reload-plugins y /alfred-dev:alfred.', 'The script needs Claude CLI and Python 3.10+. It installs with --scope user. Then /reload-plugins and /alfred-dev:alfred.')}</p>
            </div>
          </div>

          <div class="start-step">
            <strong>02</strong>
