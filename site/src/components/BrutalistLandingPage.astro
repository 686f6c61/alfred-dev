      <div class="reality-grid">
        {whatItDoes.map((item) => (
          <article class={`panel reality-card tone-${item.tone}`}>
            <div class="reality-card__index">{item.index}</div>
            <div class="reality-card__body">
              <h2>{item.title}</h2>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="beta-section" id="agentes">
