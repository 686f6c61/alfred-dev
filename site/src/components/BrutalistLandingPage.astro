        <div class="hero-install__note">
          <span class="mini-tag mini-tag--black">{tr('Instaladores por sistema', 'Installers by platform')}</span>
          <span class="hero-install__helper">{tr('Cada botón abre un popup con el comando listo para copiar.', 'Each button opens a popup with the command ready to copy.')}</span>
        </div>
      </div>

      <div class="hero-side">
        <div class="panel panel-cream changelog-card">
          <div class="changelog-card__head">
            <h2>CHANGELOG</h2>
